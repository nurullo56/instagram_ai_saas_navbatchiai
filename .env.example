# App Settings
APP_NAME="Instagram AI Automation SaaS"
APP_ENV="development" # development | staging | production
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security Secrets (Generate using: openssl rand -hex 32)
SECRET_KEY="replace_with_a_super_secret_jwt_key_at_least_32_chars_long"
ENCRYPTION_KEY="replace_with_32_byte_base64_or_hex_key_for_aes_gcm"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database (Supports RLS & pgvector)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/instagram_saas"
DB_APP_USER="saas_app_user"
DB_APP_PASSWORD="saas_app_password"
DB_WORKER_USER="saas_worker_user"
DB_WORKER_PASSWORD="saas_worker_password"
DB_INGEST_USER="saas_ingest_user"
DB_INGEST_PASSWORD="saas_ingest_password"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Meta Graph API (Official Facebook Login for Business)
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_WEBHOOK_VERIFY_TOKEN="your_custom_webhook_verification_token"
META_GRAPH_API_VERSION="v21.0"
META_GRAPH_API_BASE_URL="https://graph.facebook.com"

# AI Integration (OpenRouter)
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_api_key"
DEFAULT_AI_MODEL="meta-llama/llama-3.3-70b-instruct"
DEFAULT_EMBEDDING_MODEL="text-embedding-3-small"

# Storage (S3 / MinIO compatible)
STORAGE_PROVIDER="minio" # minio | s3
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="saas-knowledge-base"
S3_REGION="us-east-1"

# Payment Providers (Sandbox credentials)
PAYME_MERCHANT_ID="your_payme_merchant_id"
PAYME_SECRET_KEY="your_payme_secret_key"
CLICK_SERVICE_ID="your_click_service_id"
CLICK_MERCHANT_ID="your_click_merchant_id"
CLICK_SECRET_KEY="your_click_secret_key"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
